    "タップするとタイマーが始まります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start the timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするとタイマーが始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点即可开始计时。"
